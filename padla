local function unloadAll()
	if _unloaded then return end
	_unloaded = true
	for _, c in ipairs(_conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(_conns)
	for g in pairs(_suppressedGuis) do
		if g and g.Parent then
			pcall(function() g.Enabled = true end)
		end
	end
	table.clear(_suppressedGuis)
	pcall(function()
		local sg = game:GetService("StarterGui")
		sg:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
		sg:SetCoreGuiEnabled(Enum.CoreGuiType.Health, true)
	end)
	for _, g in ipairs({HUD, MessagesGui, FleetGui}) do
		if g and g.Parent then
			pcall(function() g:Destroy() end)
		end
	end
	if env.YBA_UI and env.YBA_UI.HUD == HUD then
		env.YBA_UI = nil
	end
end

