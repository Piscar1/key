	local function hookRemote(re)
		if not re or not re:IsA("RemoteEvent") then return end
		re.OnClientEvent:Connect(function(cmd, payload)
			if (cmd == "AddMessage" or cmd == "Message") and type(payload) == "table" and payload.Text then
				AddMessage(payload.Text, payload.TextColor, payload.Dura)
			elseif cmd == "Quest Completed" and type(payload) == "table" then
				ShowQuestCompleted(payload.Quest, payload.Experience, payload.Money, payload.Tool)
			end
		end)
	end
	local re = char:FindFirstChild("RemoteEvent")
	if re then hookRemote(re) end

	-- Р СџР С•Р Т‘Р С”Р В»РЎР‹РЎвЂЎР В°Р ВµР С Which Value Р Т‘Р В»РЎРЏ Fleet_Footwork Р В±Р В°РЎР‚a (Р С‘Р В»Р С‘ Р В»РЎР‹Р В±Р С•Р Вµ fleet NumberValue/IntValue)
	local function hookMeter(v)
		if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
			local ln = string.lower(v.Name)
			if string.find(ln, "fleet", 1, true) or string.find(ln, "rage", 1, true) or string.find(ln, "hamon", 1, true) or string.find(ln, "blood", 1, true) or string.find(ln, "ult", 1, true) then
				local dispName = string.gsub(v.Name, "_", " ")
				local maxV = math.max(v.MaxValue or 100, 1)
				if v.Value > 0 then
					SetChargeBar(dispName, v.Value / maxV)
				end
				v.Changed:Connect(function(nv)
					if nv > 0 then
						SetChargeBar(dispName, nv / math.max(v.MaxValue or 100, 1))
					else
						RemoveChargeBar(dispName)
					end
				end)
				v.AncestryChanged:Connect(function(_, p)
					if not p then RemoveChargeBar(dispName) end
				end)
			end
		end
	end
	for _, ch in ipairs(char:GetChildren()) do
		hookMeter(ch)
	end

	char.ChildAdded:Connect(function(ch)
		if ch.Name == "RemoteEvent" then hookRemote(ch) end
		hookMeter(ch)
	end)
end
