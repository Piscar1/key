local function suppressInviteNode(d)
	if not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
	local function checkTxt()
		local t = string.lower(d.Text)
		if string.find(t, "stand skin luck", 1, true) or string.find(t, "each friend in your server", 1, true) then
			local box = d.Parent
			while box and box.Parent and not box.Parent:IsA("LayerCollector") and string.lower(box.Parent.Name) ~= "main" and string.lower(box.Parent.Name) ~= "holders" and string.lower(box.Parent.Name) ~= "clippedcontainer" and string.lower(box.Parent.Name) ~= "notificationframe" do
				box = box.Parent
			end
			local target = (box and box:IsA("GuiObject")) and box or d
			target.Visible = false
			target:GetPropertyChangedSignal("Visible"):Connect(function()
				if target.Visible then target.Visible = false end
			end)
		end
	end
	checkTxt()
	d:GetPropertyChangedSignal("Text"):Connect(checkTxt)
end

local function suppressGui(obj)
	if obj == HUD or obj == MessagesGui or obj == FleetGui then return end
	if not obj:IsA("LayerCollector") then return end

	if SUPPRESS_SEPARATE_GUIS[obj.Name] then
		_suppressedGuis[obj] = true
		obj.Enabled = false
		track(obj:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not _unloaded and obj.Enabled then obj.Enabled = false end
