		local clone = template:Clone()
		clone.Name = plr.Name
		clone.PlayerName.Text = plr.Name
		clone.GangName.Text = "Gang-less"

		local ps = plr:FindFirstChild("PlayerStats")
		if ps then
			local gang = ps:FindFirstChild("Gang")
			if gang and gang.Value ~= "" then
				clone.GangName.Text = tostring(gang.Value)
			end
			local pres = ps:FindFirstChild("Prestige")
			if pres and tonumber(pres.Value) and tonumber(pres.Value) > 0 then
