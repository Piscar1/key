		DropAmount.Text = ""
		DropAmount.Visible = false
	end
	DropAmount.FocusLost:Connect(function(enterPressed)
		if enterPressed then submitDropMoney() end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Return and DropAmount.Visible then
			submitDropMoney()
		end
	end)
end

