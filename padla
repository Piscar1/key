				clone.Prestige.TextLabel.Text = toRoman(pv)
				if pv == 1 then
					clone.Prestige.TextLabel.TextColor3 = Color3.fromRGB(226, 155, 64)
				elseif pv == 2 then
					clone.Prestige.TextLabel.TextColor3 = Color3.fromRGB(163, 162, 165)
				elseif pv >= 3 and pv <= 5 then
					clone.Prestige.TextLabel.TextColor3 = Color3.fromRGB(239, 184, 56)
					clone.PlayerName.TextColor3 = Color3.fromRGB(239, 184, 56)
				else
					clone.Prestige.TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
		else
			local natPL = PlayerGui:FindFirstChild("PlayerListGui")
			local natRow = natPL and natPL:FindFirstChild("List", true) and natPL:FindFirstChild("List", true):FindFirstChild(plr.Name)
			if natRow then
				local ct = natRow:FindFirstChild("ClanText")
				if ct and ct:IsA("TextLabel") and ct.Text ~= "" then
					clone.GangName.Text = ct.Text
				end
				local pr = natRow:FindFirstChild("Prestige")
				local pt = pr and pr:FindFirstChild("Text")
				if pt and pt:IsA("TextLabel") and pt.Text ~= "" then
					clone.Prestige.TextLabel.Text = pt.Text
					clone.Prestige.TextLabel.TextColor3 = pt.TextColor3
					clone.PlayerName.TextColor3 = pt.TextColor3
				end
			end
		end

		local decal = clone.Prestige:FindFirstChild("Decal")
		if decal and plr:GetAttribute("DecalID") then
			clone.Prestige.TextLabel.Visible = false
			decal.Image = "http://www.roblox.com/asset/?id=" .. tostring(plr:GetAttribute("DecalID"))
			decal.Visible = true
		end

		clone.Parent = list
		if num == 1 then
			clone.Position = templatePos
		else
			clone.Position = templatePos + UDim2.new(0, 0, 0.085 / amount * (num - 1), 0)
		end
		clone.Visible = true
	end

	addNew(1, LocalPlayer)
	for idx, plr in ipairs(getPlayers) do
		addNew(1 + idx, plr)
	end
end

