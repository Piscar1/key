local function updateHealth(hp, maxHp)
	local m = math.max(tonumber(maxHp) or 100, 1)
	local ratio = math.clamp((tonumber(hp) or 0) / m, 0, 1)
	BarHealth.Size = UDim2.new(healthSize.X.Scale * ratio, 0, healthSize.Y.Scale, 0)
	TweenService:Create(BarHealthLost, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(healthSize.X.Scale * ratio, 0, healthSize.Y.Scale, 0)
	}):Play()
	if LI_Health and LI_HealthLost then
		LI_Health.Size = UDim2.new(ratio, 0, 1, 0)
		TweenService:Create(LI_HealthLost, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(ratio, 0, 1, 0)
		}):Play()
	end
end

local function updateExp(exp, lvl)
	local l = math.max(tonumber(lvl) or 1, 1)
	local req = math.max(l * LEVEL_MULTIPLIER, 1)
	local ratio = math.clamp((tonumber(exp) or 0) / req, 0, 1)
	BarExp:TweenSize(UDim2.new(expSize.X.Scale * ratio, 0, expSize.Y.Scale, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 1, true)
	LevelText.Text = tostring(l)
	if LI_Exp and LI_Level then
		LI_Exp:TweenSize(UDim2.new(ratio, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 1, true)
		LI_Level.Text = tostring(l)
	end
end

