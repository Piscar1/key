local function refreshPlayerList()
	for _, v in ipairs(list:GetChildren()) do
		if v ~= template and v ~= indicatorsList and v:IsA("GuiObject") then
			v:Destroy()
		end
	end

	local getPlayers = Players:GetPlayers()
	for i = #getPlayers, 1, -1 do
