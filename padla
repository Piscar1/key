local function toRoman(num)
	local map = {
		{1000, "M"}, {900, "CM"}, {500, "D"}, {400, "CD"},
		{100, "C"}, {90, "XC"}, {50, "L"}, {40, "XL"},
		{10, "X"}, {9, "IX"}, {5, "V"}, {4, "IV"}, {1, "I"}
	}
	local out = ""
	local v = math.floor(tonumber(num) or 0)
	for _, pair in ipairs(map) do
		while v >= pair[1] do
			out = out .. pair[2]
			v = v - pair[1]
		end
	end
	return out
end

