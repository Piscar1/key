hookNativeGui = function(obj)
	if not obj or obj:GetAttribute("_HookedByYBA") then return end
	obj:SetAttribute("_HookedByYBA", true)

	if obj.Name == "MainHUD" then
		local m = obj:FindFirstChild("Main")
		if m then
			local lvlLbl = m:FindFirstChild("Level")
			if lvlLbl and lvlLbl:IsA("TextLabel") then
				local function syncLvl()
					LevelText.Text = string.gsub(lvlLbl.Text, "^Lv%.%s*", "")
				end
				syncLvl()
				lvlLbl:GetPropertyChangedSignal("Text"):Connect(syncLvl)
			end
			local expFrame = m:FindFirstChild("Experience")
			local expDisp = expFrame and expFrame:FindFirstChild("Display")
			if expDisp and expDisp:IsA("TextLabel") then
				local function syncExp()
					local c, mx = string.match(expDisp.Text, "([%d%.]+)%s*/%s*([%d%.]+)")
					if c and mx and tonumber(mx) > 0 then
						local ratio = math.clamp(tonumber(c) / tonumber(mx), 0, 1)
						BarExp:TweenSize(UDim2.new(expSize.X.Scale * ratio, 0, expSize.Y.Scale, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.4, true)
					end
				end
				syncExp()
				expDisp:GetPropertyChangedSignal("Text"):Connect(syncExp)
			end
			local cb = m:FindFirstChild("ChargeBars")
			if cb then
				local function hookChargeBar(bar)
					if not bar:IsA("GuiObject") or bar.Name == "Template" then return end
					local title = bar.Name
					for _, d in ipairs(bar:GetDescendants()) do
						if d:IsA("TextLabel") and d.Text ~= "" then
							title = d.Text
							break
						end
					end
					local barContainer = bar:FindFirstChild("BarContainer")
					local barNode = barContainer and barContainer:FindFirstChild("Bar")
					local gradNode = barNode and barNode:FindFirstChildOfClass("UIGradient")
					local fallbackFill = barNode or bar:FindFirstChild("Fill", true) or bar:FindFirstChild("Meter2", true)

					local function syncBar()
						if not bar.Visible or not bar.Parent then
							RemoveChargeBar(title)
							return
						end
						local ratio = 0
						if gradNode then
							ratio = math.clamp(gradNode.Offset.X, 0, 1)
						elseif fallbackFill and fallbackFill:IsA("GuiObject") then
							ratio = math.clamp(fallbackFill.Size.X.Scale, 0, 1)
						end
						SetChargeBar(title, ratio)
					end

					syncBar()
					bar:GetPropertyChangedSignal("Visible"):Connect(syncBar)
					if gradNode then
						gradNode:GetPropertyChangedSignal("Offset"):Connect(syncBar)
					elseif fallbackFill and fallbackFill:IsA("GuiObject") then
						fallbackFill:GetPropertyChangedSignal("Size"):Connect(syncBar)
					end
					bar.AncestryChanged:Connect(function(_, p)
						if not p then RemoveChargeBar(title) end
					end)
				end
				for _, ch in ipairs(cb:GetChildren()) do hookChargeBar(ch) end
				cb.ChildAdded:Connect(function(ch) task.defer(hookChargeBar, ch) end)
			end
		end
	elseif obj.Name == "CurrencyGui" then
		local m = obj:FindFirstChild("CurrencyContainer")
		local mon = m and m:FindFirstChild("Money")
		local txt = mon and mon:FindFirstChild("Contents") and mon.Contents:FindFirstChild("Text")
		if txt and txt:IsA("TextLabel") then
			MoneyText.Text = string.gsub(txt.Text, ",", "")
			txt:GetPropertyChangedSignal("Text"):Connect(function()
				MoneyText.Text = string.gsub(txt.Text, ",", "")
			end)
		end
	elseif obj.Name == "NotificationGui" then
		local st = obj:FindFirstChild("Stack")
		if st then
			st.ChildAdded:Connect(function(ch)
				task.defer(function()
					for _, d in ipairs(ch:GetDescendants()) do
						if d:IsA("TextLabel") and d.Text ~= "" then
							AddMessage(d.Text, d.TextColor3, 3.5)
							break
						end
					end
				end)
			end)
		end
	elseif obj.Name == "PlayerListGui" then
		local lst = obj:FindFirstChild("List", true)
		if lst then
			lst.ChildAdded:Connect(function() task.defer(refreshPlayerList) end)
			lst.ChildRemoved:Connect(function() task.defer(refreshPlayerList) end)
			task.defer(refreshPlayerList)
		end
	end
end

