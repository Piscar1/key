AddMessage = function(text, color, dura)
	local message = MsgTemplate:Clone()
	message.Parent = MsgList
	message.Text = tostring(text)
	message.TextTransparency = 1
	message.TextStrokeTransparency = 1
	message.Name = "Message"
	message.Visible = true
	if color then message.TextColor3 = color end
	local tIn = TweenService:Create(message, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { TextTransparency = 0, TextStrokeTransparency = 0 })
	tIn:Play()
	tIn.Completed:Connect(function()
		task.wait(dura or 3.5)
		local tOut = TweenService:Create(message, TweenInfo.new(0.5, Enum.EasingStyle.Linear), { TextTransparency = 1, TextStrokeTransparency = 1 })
		tOut:Play()
		tOut.Completed:Connect(function()
			if message.Parent then message:Destroy() end
		end)
	end)
end

