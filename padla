		end
	end
	table.sort(getPlayers, function(p1, p2)
		return p1.Name:lower() < p2.Name:lower()
	end)

	local amount = #getPlayers / 9
	if amount < 1 then amount = 1 end

	templatePos = UDim2.new(template.Position.X.Scale, 0, template.Position.Y.Scale / amount, 0)
	list.CanvasSize = UDim2.new(0, 0, playerListCanvasScale * amount, 0)
